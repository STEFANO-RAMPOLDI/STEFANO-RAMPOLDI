# Configurazione del CRM SomaMed — installa.sh la copia in config.env; modifica solo config.env.
# Tre parti separate:  DATABASE (dati)  →  SERVIZIO DATI (API + Claude)  →  INTERFACCIA (pagina web)

# ---------- DATABASE ----------
# Dove sta il database (oggi in Docker su questo computer; domani su un server: cambi solo questa riga)
CRM_DSN=postgresql://crm:crm@localhost:5433/somamed_crm
# 0 = il database non è quello in Docker su questo computer (gli script non provano ad accenderlo)
CRM_DB_DOCKER=1
# Connessioni contemporanee al database (più utenti → più connessioni)
CRM_POOL_MIN=1
CRM_POOL_MAX=10
# Una richiesta che dura più di così viene interrotta (millisecondi)
CRM_TIMEOUT_QUERY_MS=30000
CRM_TZ=Europe/Rome

# ---------- SERVIZIO DATI (API) ----------
# 127.0.0.1 = solo questo computer. Per altri utenti in rete: 0.0.0.0 e una CRM_TOKEN obbligatoria.
CRM_HOST=127.0.0.1
CRM_PORT=8080
# Chiave di accesso ai dati (vuota = nessuna chiave; obbligatoria se il servizio è raggiungibile dalla rete)
CRM_TOKEN=
# Indirizzi da cui un'interfaccia ospitata altrove può leggere i dati (separati da virgola).
# L'interfaccia locale (http://127.0.0.1:8081) è sempre ammessa.
CRM_ORIGINI=

# ---------- INTERFACCIA ----------
# La pagina web, servita a parte: http://127.0.0.1:8081 (l'indirizzo dei dati è in interfaccia/config.js)
CRM_UI_HOST=127.0.0.1
CRM_UI_PORT=8081

# ---------- AI (facoltativo) ----------
# Per commentare i piani degli obiettivi direttamente nell'interfaccia.
ANTHROPIC_API_KEY=
CRM_AI_MODELLO=claude-sonnet-5-5
